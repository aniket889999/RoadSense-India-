# RoadSense India Environment Configuration (Local Only)
# Never store secrets, personal paths, or credentials in Git.

# Local API Configuration
ROADSENSE_API_HOST=127.0.0.1
ROADSENSE_API_PORT=8000
ROADSENSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence (PostgreSQL / PostGIS)
# Fallback to local SQLite is automatically enabled if PostgreSQL is unavailable
DATABASE_URL=postgresql+asyncpg://roadsense:roadsense_local_dev@127.0.0.1:5432/roadsense_india
POSTGRES_USER=roadsense
POSTGRES_PASSWORD=roadsense_local_dev
POSTGRES_DB=roadsense_india
POSTGRES_PORT=5432

# Inference & Hardware Configuration
ROADSENSE_DEVICE=mps
ROADSENSE_CONFIDENCE_THRESHOLD=0.25
ROADSENSE_IOU_THRESHOLD=0.45
ROADSENSE_MAX_FRAMES_PER_SESSION=150
ROADSENSE_SAMPLING_FPS=5.0

# Storage & Spool Directory (Relative to repository root)
ROADSENSE_SESSION_STORAGE=outputs/sessions
